{
  "name": "mfb-cinema",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" index.html",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" index.html"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "description": "Film and series discovery app built with React, TypeScript, Vite and Supabase.",
  "engines": {
    "node": ">=18"
  }
}
