VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Optional legacy key name is also supported: VITE_SUPABASE_ANON_KEY

# Optional: enables trailers, cast, streaming providers and avatar choices (TMDB API read access token).
# Note: VITE_ variables are bundled into the browser build and are not secret.
VITE_TMDB_ACCESS_TOKEN=

# Optional: IMDb rating lookups through OMDb.
VITE_OMDB_API_KEY=

# Optional: base URL of the legacy ASP.NET API (defaults to http://localhost:8080).
# VITE_API_BASE_URL=http://localhost:8080
