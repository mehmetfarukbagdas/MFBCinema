# Frontend: copy frontend/.env.example to frontend/.env.local and fill in Supabase values.
# Optional legacy ASP.NET API (not used for Supabase email auth):
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_KEY=replace-with-a-long-random-secret-at-least-32-characters

# Optional legacy ASP.NET API admin allowlist (comma-separated is not used; use JSON array env syntax instead).
# Set ADMIN_EMAIL only if intentionally using the legacy API admin allowlist.
# ADMIN_EMAIL=admin@example.com

# Comma-separated allowed frontend origins for the optional ASP.NET API.
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.example
